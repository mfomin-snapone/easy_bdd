# Fill-in Template for Strict-v2 Draft Cases (Project 59 / Suite 107622 / Section 2890100)
# Copy needed keys into your local .env and replace placeholder values.
#
# A seeded TestRail Var case exists with this structure:
# C18808614 - Var: Builder Strict V3 - Araknis Defaults

# ------------------------------------------------------------
# Global runtime (required by all 20 cases)
# ------------------------------------------------------------
device_url=http://<device-host>
device_api_url=http://<device-host>/api
ws_url=ws://<device-host>/ws
save_selector=<css-or-xpath-save-button>
settle_seconds=15

# C18738087-inspired UI flow defaults
ui_username=<ui-username>
ui_password=<ui-password>
login_username_selector=#login-usernameIpt
login_password_selector=#login-passwordIpt
login_button_selector=//button[@id="login-login-btn"]/span
post_login_ready_selector=#system-name-value
post_login_timeout=10000
pending_changes_nav_selector=//div[@id="sidebar"]/div[2]/a/span
pending_changes_value_selector=//td[@id="unsaved-changes-list-value"]/div/div
pending_change_token=<change-token-text>
apply_button_selector=//button[@id="unsaved-apply-btn"]/span
post_apply_ready_selector=#system-name-value
post_apply_timeout=15000

# Optional common nav selectors
system_settings_nav_selector=//a[@id="sidebar-settings-systemSettings"]/span
network_settings_nav_selector=<css-or-xpath-network-settings-nav>
wireless_settings_nav_selector=<css-or-xpath-wireless-settings-nav>

# ------------------------------------------------------------
# System Name family
# C18808593
# ------------------------------------------------------------
system_name_selector=<css-or-xpath-system-name-input>
system_name_value=Automation-System-01
system_name_display_selector=<css-or-xpath-system-name-display>

# ------------------------------------------------------------
# Admin Username family
# C18808594
# ------------------------------------------------------------
admin_username_selector=<css-or-xpath-admin-username-input>
admin_username_value=automation_admin
admin_username_display_selector=<css-or-xpath-admin-username-display>

# ------------------------------------------------------------
# Admin Password family
# C18808595
# ------------------------------------------------------------
current_password_selector=<css-or-xpath-current-password-input>
current_password=<current-admin-password>
new_password_selector=<css-or-xpath-new-password-input>
new_password=<new-admin-password>
confirm_password_selector=<css-or-xpath-confirm-password-input>
password_update_success_text=Password updated

# ------------------------------------------------------------
# Management VLAN family
# C18808596
# ------------------------------------------------------------
management_vlan_mode_selector=<css-or-xpath-vlan-mode-select>
management_vlan_mode=Tagged
management_vlan_id_selector=<css-or-xpath-vlan-id-input>
management_vlan_id=100
ui_success_text=Saved

# ------------------------------------------------------------
# Date and Time Settings family
# C18808597
# ------------------------------------------------------------
date_input_selector=<css-or-xpath-date-input>
date_value=2026/07/24
time_input_selector=<css-or-xpath-time-input>
time_value=14:30
datetime_display_selector=<css-or-xpath-datetime-display>

# ------------------------------------------------------------
# Time Zone family
# C18808598
# ------------------------------------------------------------
timezone_selector=<css-or-xpath-timezone-select>
timezone_value=America/Chicago
daylight_savings_toggle_selector=<css-or-xpath-daylight-savings-toggle>
timezone_display_selector=<css-or-xpath-timezone-display>

# ------------------------------------------------------------
# IP Settings DHCP family
# C18808599
# ------------------------------------------------------------
ip_mode_selector=<css-or-xpath-ip-mode-select>
ip_mode_display_selector=<css-or-xpath-ip-mode-display>

# ------------------------------------------------------------
# IP Settings Static family
# C18808600
# ------------------------------------------------------------
ip_address_selector=<css-or-xpath-static-ip-input>
static_ip=192.168.1.50
subnet_selector=<css-or-xpath-subnet-input>
static_subnet=255.255.255.0
gateway_selector=<css-or-xpath-gateway-input>
static_gateway=192.168.1.1
primary_dns_selector=<css-or-xpath-primary-dns-input>
static_dns_primary=1.1.1.1
ip_address_display_selector=<css-or-xpath-ip-display>

# ------------------------------------------------------------
# Interface Settings family
# C18808601
# ------------------------------------------------------------
lan_port_selector=<css-or-xpath-lan-port-select>
lan_port=LAN1
speed_selector=<css-or-xpath-speed-select>
speed_value=Auto
duplex_selector=<css-or-xpath-duplex-select>
duplex_value=Auto

# ------------------------------------------------------------
# WAP Mode family
# C18808602
# ------------------------------------------------------------
wap_mode_selector=<css-or-xpath-wap-mode-select>
wap_mode_value=Standalone
mode_display_selector=<css-or-xpath-mode-display>

# ------------------------------------------------------------
# Fast Roaming family
# C18808603
# ------------------------------------------------------------
fast_roaming_toggle_selector=<css-or-xpath-fast-roaming-toggle>

# ------------------------------------------------------------
# Networks SSID family
# C18808604-C18808609
# ------------------------------------------------------------
ssid_name_selector=<css-or-xpath-ssid-name-input>
ssid_name=TestSSID-Auto
ssid_security_selector=<css-or-xpath-ssid-security-select>
ssid_security_mode=WPA2-PSK
ssid_band_selector=<css-or-xpath-ssid-band-select>
ssid_band=2.4
ssid_broadcast_toggle_selector=<css-or-xpath-ssid-broadcast-toggle>
ssid_display_selector=<css-or-xpath-ssid-display>

# ------------------------------------------------------------
# Guest Network family
# C18808610-C18808612
# ------------------------------------------------------------
guest_ssid_selector=<css-or-xpath-guest-ssid-input>
guest_ssid_name=GuestNetwork-Auto
guest_security_mode_selector=<css-or-xpath-guest-security-select>
guest_security_mode=WPA2-PSK
guest_band_selector=<css-or-xpath-guest-band-select>
guest_band=2.4
guest_broadcast_toggle_selector=<css-or-xpath-guest-broadcast-toggle>
guest_ssid_display_selector=<css-or-xpath-guest-ssid-display>
